# Build outputs
*.iml
.gradle/
.idea/
local.properties
build/
app/build/
captures/

# Packages: only apks/*.apk is whitelisted as a release artifact
*.apk
*.aab
!apks/*.apk

# Signing material must never be committed
*.jks
*.keystore
keystore.properties

# Robolectric offline runtime (150MB, machine-local)
robolectric-deps/

# Python cache from design-export/export_ui.py
__pycache__/
*.pyc

# Build logs
*.log
build_out.log
build_err.log
rel.log
rel.err.log

# Local scratch (probe scripts, headless screenshots)
.tmp-audit/
.tmp-shot/
