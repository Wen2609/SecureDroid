<?xml version="1.0" encoding="utf-8"?>
<!--
  样式层:所有尺寸与颜色都指向 design 令牌,布局只写语义。
  字阶按设计图实测重建:标题 24sp / 卡标题 18sp / 状态 17sp / 卡副标题 15sp /
  圆环数字 54sp / 小节标签 13sp(不用全大写)。按钮统一胶囊形(圆角=高的一半)。
-->
<resources>

    <!-- 形状 -->
    <style name="ShapeAppearance.SecureDroid.Card" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">@dimen/sd_radius_card</item>
    </style>
    <style name="ShapeAppearance.SecureDroid.Inner" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">@dimen/sd_radius_inner</item>
    </style>

    <!-- 字阶 -->
    <style name="TextAppearance.SecureDroid.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="TextAppearance.SecureDroid.Headline" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.SecureDroid.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">6dp</item>
    </style>
    <style name="TextAppearance.SecureDroid.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
    </style>
    <style name="TextAppearance.SecureDroid.Section" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
    <style name="TextAppearance.SecureDroid.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">13sp</item>
    </style>

    <!-- 卡片:白底 + 24dp 圆角 + 极淡阴影(设计图卡片没有描边) -->
    <style name="Widget.SecureDroid.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/c_glass</item>
        <item name="cardCornerRadius">@dimen/sd_radius_card</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/c_glass_border</item>
        <item name="rippleColor">@color/c_muted</item>
    </style>
    <!-- 列表容器卡:上下各留 4dp,让首/末行贴住圆角 -->
    <!-- 首页四宫格入口卡:可点 + 固定高度 -->

    <!-- 主按钮:品牌绿胶囊。彩色阴影(outline*ShadowColor)是 API 28+ 才有的属性,
         放在 values-v28/styles.xml 里追加,避免在低版本上被 Lint 判为 NewApi 错误。 -->
    <style name="Widget.SecureDroid.Button.Base" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/sd_cta_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">@dimen/sd_radius_pill</item>
        <item name="backgroundTint">@color/c_primary</item>
        <item name="android:textColor">@color/c_on_primary</item>
        <item name="iconTint">@color/c_on_primary</item>
        <item name="iconPadding">@dimen/sd_space_2</item>
        <item name="android:elevation">2dp</item>
    </style>
    <style name="Widget.SecureDroid.Button" parent="Widget.SecureDroid.Button.Base" />
    <!-- 列表行:整行可点,左侧对齐,右侧留给箭头 -->
    <!-- 分段控件 -->
    <!-- 分段轨道:浅底胶囊 + 3dp 内边距,内层按钮自带选中白胶囊 -->

    <!-- ===== 新界面组件 ===== -->

</resources>
