<?xml version="1.0" encoding="utf-8"?>
<!--
  样式层:所有尺寸与颜色都指向 design 令牌,布局只写语义。
  字阶按设计图实测重建:标题 24sp / 卡标题 18sp / 状态 17sp / 卡副标题 15sp /
  圆环数字 54sp / 小节标签 13sp(不用全大写)。按钮统一胶囊形(圆角=高的一半)。
-->
<resources>

    <!-- 形状 -->
    <style name="ShapeAppearance.SecureDroid.Card" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">@dimen/sd_radius_card</item>
    </style>
    <style name="ShapeAppearance.SecureDroid.Inner" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">@dimen/sd_radius_inner</item>
    </style>

    <!-- 字阶 -->
    <style name="TextAppearance.SecureDroid.Score" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textSize">54sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.04</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="TextAppearance.SecureDroid.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="TextAppearance.SecureDroid.Headline" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.SecureDroid.Status" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">17sp</item>
    </style>
    <style name="TextAppearance.SecureDroid.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">6dp</item>
    </style>
    <style name="TextAppearance.SecureDroid.Tile" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">15sp</item>
    </style>
    <style name="TextAppearance.SecureDroid.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
    </style>
    <style name="TextAppearance.SecureDroid.Section" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
    <style name="TextAppearance.SecureDroid.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">13sp</item>
    </style>
    <style name="TextAppearance.SecureDroid.Nav" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.SecureDroid.Keypad" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">24sp</item>
    </style>

    <!-- 卡片:白底 + 24dp 圆角 + 极淡阴影(设计图卡片没有描边) -->
    <style name="Widget.SecureDroid.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/c_glass</item>
        <item name="cardCornerRadius">@dimen/sd_radius_card</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/c_glass_border</item>
        <item name="rippleColor">@color/c_muted</item>
    </style>
    <!-- 列表容器卡:上下各留 4dp,让首/末行贴住圆角 -->
    <style name="Widget.SecureDroid.CardList" parent="Widget.SecureDroid.Card">
        <item name="android:paddingTop">@dimen/sd_card_list_pad</item>
        <item name="android:paddingBottom">@dimen/sd_card_list_pad</item>
    </style>
    <!-- 首页四宫格入口卡:可点 + 固定高度 -->
    <style name="Widget.SecureDroid.Tile" parent="Widget.SecureDroid.Card">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- 主按钮:品牌绿胶囊。彩色阴影(outline*ShadowColor)是 API 28+ 才有的属性,
         放在 values-v28/styles.xml 里追加,避免在低版本上被 Lint 判为 NewApi 错误。 -->
    <style name="Widget.SecureDroid.Button.Base" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/sd_cta_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">@dimen/sd_radius_pill</item>
        <item name="backgroundTint">@color/c_primary</item>
        <item name="android:textColor">@color/c_on_primary</item>
        <item name="iconTint">@color/c_on_primary</item>
        <item name="iconPadding">@dimen/sd_space_2</item>
        <item name="android:elevation">2dp</item>
    </style>
    <style name="Widget.SecureDroid.Button" parent="Widget.SecureDroid.Button.Base" />
    <style name="Widget.SecureDroid.Button.Accent" parent="Widget.SecureDroid.Button">
        <item name="backgroundTint">@color/c_accent</item>
        <item name="android:textColor">@color/c_on_accent</item>
        <item name="iconTint">@color/c_on_accent</item>
    </style>
    <style name="Widget.SecureDroid.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/sd_touch_min</item>
        <item name="cornerRadius">@dimen/sd_radius_pill</item>
        <item name="strokeColor">@color/c_border</item>
        <item name="android:textColor">@color/c_foreground</item>
        <item name="iconTint">@color/c_foreground</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <!-- 列表行:整行可点,左侧对齐,右侧留给箭头 -->
    <style name="Widget.SecureDroid.Button.Row" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/sd_row_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">@dimen/sd_space_4</item>
        <item name="android:paddingEnd">44dp</item>
        <item name="cornerRadius">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/sd_space_3</item>
        <item name="iconTint">@color/c_muted_foreground</item>
        <item name="android:textColor">@color/c_foreground</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="rippleColor">@color/c_muted</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <!-- 分段控件 -->
    <style name="Widget.SecureDroid.Segment" parent="Widget.Material3.Button.TextButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.005</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/sd_seg_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="cornerRadius">@dimen/sd_radius_pill</item>
        <item name="backgroundTint">@color/seg_bg</item>
        <item name="android:textColor">@color/seg_text</item>
        <item name="strokeWidth">0dp</item>
        <item name="rippleColor">@color/c_muted</item>
    </style>
    <!-- 分段轨道:浅底胶囊 + 3dp 内边距,内层按钮自带选中白胶囊 -->
    <style name="Widget.SecureDroid.SegmentTrack" parent="">
        <item name="android:background">@drawable/bg_seg_track</item>
        <item name="android:padding">@dimen/sd_seg_track_pad</item>
        <item name="android:orientation">horizontal</item>
    </style>
    <style name="Widget.SecureDroid.Chip" parent="">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingStart">@dimen/sd_space_2</item>
        <item name="android:paddingEnd">@dimen/sd_space_2</item>
        <item name="android:paddingTop">@dimen/sd_space_1</item>
        <item name="android:paddingBottom">@dimen/sd_space_1</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
    </style>
    <style name="Widget.SecureDroid.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/sd_hairline_width</item>
        <item name="android:layout_marginStart">@dimen/sd_divider_inset</item>
        <item name="android:background">@color/c_border</item>
    </style>

    <!-- ===== 新界面字阶(v1.8.0,字号/字距取自上传稿) ===== -->
    <style name="TextAppearance.SecureDroid.PageTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">25sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.018</item>
    </style>
    <style name="TextAppearance.SecureDroid.Greeting" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
    <style name="TextAppearance.SecureDroid.HeroTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>
    <style name="TextAppearance.SecureDroid.HeroMeta" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">13.5sp</item>
        <item name="android:letterSpacing">0.005</item>
    </style>
    <style name="TextAppearance.SecureDroid.StatValue" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="TextAppearance.SecureDroid.StatLabel" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">11.5sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
    <style name="TextAppearance.SecureDroid.FeatureTitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.005</item>
    </style>
    <style name="TextAppearance.SecureDroid.FeatureSub" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12.5sp</item>
        <item name="android:letterSpacing">0.005</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="TextAppearance.SecureDroid.ActivityTitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.005</item>
    </style>
    <style name="TextAppearance.SecureDroid.ActivityTime" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.005</item>
    </style>
    <style name="TextAppearance.SecureDroid.ScanHint" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="TextAppearance.SecureDroid.CardHead" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
    <style name="TextAppearance.SecureDroid.EmptyHint" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="TextAppearance.SecureDroid.ProtectionTitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.005</item>
    </style>
    <style name="TextAppearance.SecureDroid.ProtectionSub" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12.5sp</item>
        <item name="android:letterSpacing">0.005</item>
    </style>
    <style name="TextAppearance.SecureDroid.RowTitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.005</item>
    </style>
    <style name="TextAppearance.SecureDroid.RowSub" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.005</item>
    </style>
    <style name="TextAppearance.SecureDroid.Badge" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- ===== 新界面组件 ===== -->
    <style name="Widget.SecureDroid.DockItem" parent="">
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/selector_dock_item</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="Widget.SecureDroid.Badge" parent="">
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:paddingStart">@dimen/sd_badge_pad_h</item>
        <item name="android:paddingEnd">@dimen/sd_badge_pad_h</item>
        <item name="android:paddingTop">@dimen/sd_badge_pad_v</item>
        <item name="android:paddingBottom">@dimen/sd_badge_pad_v</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- ===== 玻璃弹窗组件(v1.9.7,对齐 2026-10-04 设计令牌) ===== -->
    <style name="Widget.SecureDroid.Dialog.Button" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@color/c_primary</item>
        <item name="android:textAppearance">@style/TextAppearance.SecureDroid.Label</item>
        <item name="android:minHeight">@dimen/sd_touch_min</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:letterSpacing">0.005</item>
    </style>

    <!-- ===== 应用锁键盘玻璃键(v1.9.8,界面统一修复) ===== -->
    <style name="Widget.SecureDroid.Button.Keypad" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/sd_radius_inner</item>
        <item name="backgroundTint">@color/c_glass</item>
        <item name="strokeColor">@color/c_glass_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/c_muted</item>
        <item name="android:textColor">@color/c_foreground</item>
        <item name="android:textAppearance">@style/TextAppearance.SecureDroid.Keypad</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

</resources>
