<?xml version="1.0" encoding="utf-8"?>
<!--
  设计令牌 · 色彩(浅色)
  依据 ColorOS 17「流体设计」+ Apple HIG + UI/UX Pro Max 规则库。
  原则:内容层用**色调层级**区分表面(不靠描边),描边只留给功能层玻璃;
  语义色只用于状态,不用于装饰。
-->
<resources>
    <!-- 兼容旧名 -->
    <color name="primary">#0B57D0</color>
    <color name="ic_launcher_background">#0B57D0</color>
    <color name="status_safe">@color/sd_safe</color>
    <color name="status_risky">@color/sd_warn</color>
    <color name="status_malicious">@color/sd_danger</color>

    <!-- 品牌:信任蓝 + 凝光青 -->
    <color name="sd_brand">#0B57D0</color>
    <color name="sd_glow">#0FB5D6</color>
    <color name="sd_on_primary">#FFFFFF</color>

    <!-- 内容层底色 -->
    <color name="sd_bg">#F4F7FC</color>
    <color name="sd_bg_alt">#E9F0FA</color>
    <color name="sd_bloom">#1F2F7BFF</color>
    <color name="sd_bloom_clear">#002F7BFF</color>

    <!-- 表面层级:1(卡片) → 2(卡内嵌套块) → 3(强调块) -->
    <color name="sd_surface">#FFFFFF</color>
    <color name="sd_surface_soft">#F7FAFF</color>

    <!-- 功能层玻璃(工具栏 / 底部入口条) -->
    <color name="sd_glass">#F2FFFFFF</color>
    <color name="sd_glass_strong">#FAFFFFFF</color>
    <color name="sd_hairline">#140B1220</color>
    <color name="sd_hairline_soft">#0D0B1220</color>
    <color name="sd_highlight">#66FFFFFF</color>
    <color name="sd_ring_track">#140B1220</color>

    <!-- 文本 -->
    <color name="sd_text">#0B1220</color>
    <color name="sd_text_secondary">#4C5C77</color>
    <color name="sd_text_tertiary">#78879E</color>
    <color name="sd_on_brand">#FFFFFF</color>

    <!-- 语义状态 -->
    <color name="sd_safe">#12734A</color>
    <color name="sd_warn">#8A5200</color>
    <color name="sd_danger">#B4232A</color>
    <color name="sd_danger_solid">#B4232A</color>
</resources>