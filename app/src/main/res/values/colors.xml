<?xml version="1.0" encoding="utf-8"?>
<!--
  颜色令牌(浅色)。这是当前成品的实际配色(设计系统已于 2026-10-02 移除,数值原样保留):
  品牌绿 #04BD19(主按钮)、弧线绿 #31D027、环底 #E4EDE2、环内圆盘 #EAF4E8、
  正文 #1A1A1A、次级文字 #6B6B6B(对比度 5.33:1,已达 AA)、风险红 #D03B37(4.81:1 达标)、
  卡片 #FFFFFF、悬浮导航 #FDFDFD、页面背景为 #F3F8EE 到 #EFF0F0 的垂直渐变(见 drawable/bg_page.xml)。
  布局里禁止出现字面色值,一律引用这里的语义名(DesignRuleTest 强制)。
-->
<resources>
    <!-- 品牌与强调 -->
    <color name="c_primary">#FF04BD19</color>
    <color name="c_on_primary">#FFFFFFFF</color>
    <color name="c_primary_container">#FFD8F4D9</color>
    <color name="c_on_primary_container">#FF06330B</color>
    <color name="c_accent">#FF15803D</color>
    <color name="c_on_accent">#FFFFFFFF</color>

    <!-- 页面与文字 -->
    <color name="c_background">#FFF2F4EF</color>
    <color name="c_bg_top">#FFF3F8EE</color>
    <color name="c_bg_bottom">#FFEFF0F0</color>
    <color name="c_foreground">#FF1A1A1A</color>
    <color name="c_card">#FFFFFFFF</color>
    <color name="c_nav">#FFFDFDFD</color>
    <color name="c_muted">#FFE6EDE4</color>
    <color name="c_muted_foreground">#FF6B6B6B</color>
    <color name="c_border">#FFDFE4DD</color>

    <!-- 语义 -->
    <color name="c_destructive">#FFD03B37</color>
    <color name="c_on_destructive">#FFFFFFFF</color>
    <color name="c_gold">#FFA16207</color>
    <color name="c_success">#FF15803D</color>

    <!-- 首页大圆环 -->
    <color name="c_ring">#FF31D027</color>
    <color name="c_ring_track">#FFE4EDE2</color>
    <color name="c_ring_disc">#FFEAF4E8</color>

    <!-- 应用图标(自适应图标底色 + 白色盾牌 + 品牌绿对勾) -->
    <color name="ic_launcher_background">#FF0B7A1C</color>

    <!-- 语义别名:调用方按用途取色,不必记忆具体色名 -->
    <color name="status_safe">@color/c_success</color>
    <color name="status_risky">@color/c_gold</color>
    <color name="status_malicious">@color/c_destructive</color>
    <color name="sd_hairline">@color/c_border</color>
    <color name="sd_warn">@color/c_gold</color>
    <color name="sd_danger">@color/c_destructive</color>
</resources>
