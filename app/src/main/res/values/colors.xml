<?xml version="1.0" encoding="utf-8"?>
<!--
  设计令牌 · 色彩(浅色)—— Apple 系统色(iOS Human Interface Guidelines · Color / System colors)

  HIG 明确要求:用**语义化动态色**,不要按外观硬编码;同一颜色不得表达两种含义。
  这里直接采用 iOS 系统色的角色命名(label / separator / systemGroupedBackground …),
  深色变体在 values-night 中一一对应(与 iOS 的 light/dark 变体数值一致)。
  旧令牌名(sd_brand/sd_text/…)保留为别名,避免推翻既有布局。
-->
<resources>
    <!-- iOS 系统色(浅色外观) -->
    <color name="ios_blue">#007AFF</color>
    <color name="ios_green">#34C759</color>
    <color name="ios_orange">#FF9500</color>
    <color name="ios_red">#FF3B30</color>
    <color name="ios_gray">#8E8E93</color>
    <color name="ios_gray2">#AEAEB2</color>
    <color name="ios_gray4">#D1D1D6</color>
    <color name="ios_gray5">#E5E5EA</color>
    <color name="ios_gray6">#F2F2F7</color>

    <color name="ios_label">#000000</color>
    <color name="ios_label_secondary">#3C3C4399</color>
    <color name="ios_label_tertiary">#3C3C434D</color>
    <color name="ios_separator">#3C3C4349</color>
    <color name="ios_opaque_separator">#C6C6C8</color>
    <color name="ios_system_bg">#FFFFFF</color>
    <color name="ios_secondary_bg">#F2F2F7</color>
    <color name="ios_grouped_card">#FFFFFF</color>
    <color name="ios_fill">#7676801F</color>
    <color name="ios_segment_selected">#FFFFFF</color>
    <color name="ios_tabbar">#F9F9F9F2</color>

    <!-- 兼容旧名(映射到系统色角色) -->
    <color name="primary">@color/ios_blue</color>
    <color name="ic_launcher_background">@color/ios_blue</color>
    <color name="status_safe">@color/ios_green</color>
    <color name="status_risky">@color/ios_orange</color>
    <color name="status_malicious">@color/ios_red</color>

    <color name="sd_brand">@color/ios_blue</color>
    <!-- 旧令牌别名:Apple 风格里没有"凝光渐变",次要强调色等同 systemBlue -->
    <color name="sd_glow">@color/ios_blue</color>
    <color name="sd_on_primary">#FFFFFF</color>
    <color name="sd_bg">@color/ios_secondary_bg</color>
    <color name="sd_bg_alt">@color/ios_secondary_bg</color>
    <color name="sd_bloom">#00000000</color>
    <color name="sd_bloom_clear">#00000000</color>
    <color name="sd_surface">@color/ios_grouped_card</color>
    <color name="sd_surface_soft">@color/ios_secondary_bg</color>
    <color name="sd_glass">@color/ios_tabbar</color>
    <color name="sd_glass_strong">@color/ios_fill</color>
    <color name="sd_hairline">@color/ios_separator</color>
    <color name="sd_hairline_soft">@color/ios_separator</color>
    <color name="sd_highlight">#00000000</color>
    <color name="sd_ring_track">@color/ios_gray5</color>
    <color name="sd_text">@color/ios_label</color>
    <color name="sd_text_secondary">#3C3C4399</color>
    <color name="sd_text_tertiary">#3C3C4373</color>
    <color name="sd_on_brand">#FFFFFF</color>
    <color name="sd_safe">@color/ios_green</color>
    <color name="sd_warn">@color/ios_orange</color>
    <color name="sd_danger">@color/ios_red</color>
    <color name="sd_danger_solid">@color/ios_red</color>
</resources>