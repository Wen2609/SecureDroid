<?xml version="1.0" encoding="utf-8"?>
<!-- 应用主题:把设计令牌接到 Material 3 主题属性,窗口背景用设计图的垂直渐变 -->
<resources>
    <style name="Theme.SecureDroid" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/c_primary</item>
        <item name="colorOnPrimary">@color/c_on_primary</item>
        <item name="colorPrimaryContainer">@color/c_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/c_on_primary_container</item>
        <item name="colorSecondary">@color/c_accent</item>
        <item name="colorOnSecondary">@color/c_on_accent</item>

        <item name="android:colorBackground">@color/c_background</item>
        <item name="colorSurface">@color/c_card</item>
        <item name="colorOnSurface">@color/c_foreground</item>
        <item name="colorSurfaceVariant">@color/c_muted</item>
        <item name="colorOnSurfaceVariant">@color/c_muted_foreground</item>
        <item name="colorOutline">@color/c_border</item>
        <item name="colorOutlineVariant">@color/c_border</item>
        <item name="colorError">@color/c_destructive</item>
        <item name="colorOnError">@color/c_on_destructive</item>

        <item name="android:windowBackground">@drawable/bg_page</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/c_bg_bottom</item>

        <item name="materialCardViewStyle">@style/Widget.SecureDroid.Card</item>
        <item name="materialButtonStyle">@style/Widget.SecureDroid.Button</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.SecureDroid.Title</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.SecureDroid.Headline</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.SecureDroid.Section</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.SecureDroid.Body</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.SecureDroid.Label</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.SecureDroid.Label</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.SecureDroid.Card</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.SecureDroid.Inner</item>
    </style>
</resources>
