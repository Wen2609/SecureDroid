<?xml version="1.0" encoding="utf-8"?>
<!--
  设计令牌 · 尺寸(iOS 度量,按 Android 规范取整)
  - 屏幕边距 16dp(iOS grouped list 标准 16pt);
  - 列表行 48dp:iOS 是 44pt,但 Android 平台规范要求 ≥48dp 触摸目标,取更严的一方;
  - 分组卡片圆角 10dp(iOS inset grouped 的标准圆角);
  - 分隔线 0.5dp(Apple 的 hairline 是 0.33pt)。
-->
<resources>
    <dimen name="sd_space_1">4dp</dimen>
    <dimen name="sd_space_2">8dp</dimen>
    <dimen name="sd_space_3">12dp</dimen>
    <dimen name="sd_space_4">16dp</dimen>
    <dimen name="sd_space_5">24dp</dimen>
    <dimen name="sd_space_6">32dp</dimen>

    <dimen name="sd_gutter">16dp</dimen>
    <dimen name="sd_touch_min">48dp</dimen>
    <dimen name="sd_row_height">48dp</dimen>
    <dimen name="sd_tabbar_height">50dp</dimen>

    <dimen name="sd_radius_card">10dp</dimen>
    <dimen name="sd_radius_inner">8dp</dimen>
    <dimen name="sd_radius_pill">100dp</dimen>
    <dimen name="sd_hairline_width">0.5dp</dimen>

    <dimen name="sd_hero_ring">180dp</dimen>
    <dimen name="sd_btn_height">50dp</dimen>
    <dimen name="sd_card_elevation">0dp</dimen>
    <dimen name="sd_segment_height">32dp</dimen>
    <dimen name="sd_segment_hit">44dp</dimen>
</resources>