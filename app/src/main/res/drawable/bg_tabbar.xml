<?xml version="1.0" encoding="utf-8"?>
<!-- 标签栏:iOS 是一条通栏的半透明条 + 顶部 0.5dp 分隔线,不是悬浮圆角面板 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sd_glass" />
        </shape>
    </item>
    <item android:gravity="top" android:height="@dimen/sd_hairline_width">
        <shape android:shape="rectangle">
            <solid android:color="@color/sd_hairline" />
        </shape>
    </item>
</layer-list>