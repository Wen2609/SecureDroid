<?xml version="1.0" encoding="utf-8"?>
<!-- 玻璃弹窗背景:24dp 大圆角半透明面 + 1dp 高光边框(对齐 blur-overlay / color-surface) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
       android:shape="rectangle">
    <solid android:color="@color/c_glass" />
    <stroke
            android:width="1dp"
            android:color="@color/c_glass_border" />
    <corners android:radius="24dp" />
</shape>