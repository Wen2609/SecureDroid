<?xml version="1.0" encoding="utf-8"?>
<!-- 功能层玻璃面板(底部入口条):半透明填充 + 1dp 亮边 + 顶部高光,内容从其下透出 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="@dimen/sd_radius_card" android:topRightRadius="@dimen/sd_radius_card" />
            <solid android:color="@color/sd_glass" />
            <stroke android:width="@dimen/sd_hairline_width" android:color="@color/sd_hairline" />
        </shape>
    </item>
    <item android:gravity="top" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/sd_highlight" />
        </shape>
    </item>
</layer-list>