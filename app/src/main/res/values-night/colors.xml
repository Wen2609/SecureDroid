    <color name="sd_glow">@color/c_accent</color>
    <color name="sd_on_brand">@color/c_on_primary</color>
    <color name="sd_bg">@color/c_background</color>
    <color name="sd_bg_alt">@color/c_background</color>
    <color name="sd_bloom">#00000000</color>
    <color name="sd_bloom_clear">#00000000</color>
    <color name="sd_surface">@color/c_card</color>
    <color name="sd_surface_soft">@color/c_muted</color>
    <color name="sd_glass">@color/c_card</color>
    <color name="sd_glass_strong">@color/c_muted</color>
    <color name="sd_hairline">@color/c_border</color>
    <color name="sd_hairline_soft">@color/c_border</color>
    <color name="sd_highlight">#00000000</color>
    <color name="sd_ring_track">@color/c_muted</color>
    <color name="sd_text">@color/c_foreground</color>
    <color name="sd_text_secondary">@color/c_muted_foreground</color>
    <color name="sd_text_tertiary">#64748B</color>
    <color name="sd_safe">@color/c_success</color>
    <color name="sd_warn">@color/c_gold</color>
    <color name="sd_danger">@color/c_destructive</color>
    <color name="sd_danger_solid">@color/c_destructive</color>

    <color name="ios_blue">@color/c_accent</color>
