<?xml version="1.0" encoding="utf-8"?>
<!--
  设计令牌 · 色彩(深色)
  来源:ui-ux-pro-max 的 color 域查询(dark mode surface elevation contrast)返回的深色表面层级
  (Background/Card/Muted/Border/Foreground 五级),与浅色同一套角色命名。
  偏差说明:技能返回的深色 accent 是 #EF4444(与 destructive 同色),用它做 CTA 会违反
  "同一颜色不得表达两种含义",因此 CTA 改用 #38BDF8(在 #020617 上对比度 > 8:1)。
-->
<resources>
    <color name="c_primary">#F8FAFC</color>
    <color name="c_on_primary">#0F172A</color>
    <color name="c_secondary">#1E293B</color>
    <color name="c_accent">#38BDF8</color>
    <color name="c_on_accent">#04121F</color>
    <color name="c_background">#020617</color>
    <color name="c_foreground">#F8FAFC</color>
    <color name="c_card">#0E1223</color>
    <color name="c_card_foreground">#F8FAFC</color>
    <color name="c_muted">#1A1E2F</color>
    <color name="c_muted_foreground">#94A3B8</color>
    <color name="c_border">#334155</color>
    <color name="c_destructive">#EF4444</color>
    <color name="c_on_destructive">#000000</color>
    <color name="c_ring">#FFFFFF</color>
    <color name="c_gold">#FBBF24</color>
    <color name="c_success">#22C55E</color>

    <color name="primary">@color/c_primary</color>
    <color name="ic_launcher_background">#0F172A</color>
    <color name="status_safe">@color/c_success</color>
    <color name="status_risky">@color/c_gold</color>
    <color name="status_malicious">@color/c_destructive</color>

    <color name="sd_brand">@color/c_primary</color>
