<?xml version="1.0" encoding="utf-8"?>
<!-- 深色主题:仅覆盖与浅色不同的部分(状态栏图标、导航栏底色) -->
<resources>
    <style name="Theme.SecureDroid" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/sd_brand</item>
        <item name="colorOnPrimary">@color/sd_on_primary</item>
        <item name="colorPrimaryContainer">@color/sd_brand</item>
        <item name="colorOnPrimaryContainer">@color/sd_on_primary</item>
        <item name="colorSecondary">@color/sd_glow</item>
        <item name="colorOnSecondary">@color/sd_on_brand</item>

        <item name="android:colorBackground">@color/sd_bg</item>
        <item name="colorSurface">@color/sd_surface</item>
        <item name="colorOnSurface">@color/sd_text</item>
        <item name="colorSurfaceVariant">@color/sd_surface_soft</item>
        <item name="colorOnSurfaceVariant">@color/sd_text_secondary</item>
        <item name="colorOutline">@color/sd_hairline</item>
        <item name="colorOutlineVariant">@color/sd_hairline_soft</item>
        <item name="colorError">@color/sd_danger</item>
        <item name="colorOnError">@color/sd_on_primary</item>

        <item name="android:windowBackground">@drawable/bg_fluid</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/sd_bg</item>

        <item name="materialCardViewStyle">@style/Widget.SecureDroid.Card</item>
        <item name="materialButtonStyle">@style/Widget.SecureDroid.Button</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.SecureDroid.Title</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.SecureDroid.Title</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.SecureDroid.Section</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.SecureDroid.Body</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.SecureDroid.Label</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.SecureDroid.Label</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.SecureDroid.Card</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.SecureDroid.Inner</item>
    </style>
</resources>