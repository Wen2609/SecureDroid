<?xml version="1.0" encoding="utf-8"?>
<!-- 界面布局:可直接手改;颜色与尺寸引用 res/values 令牌(DesignRuleTest 校验触摸目标与令牌化) -->
<ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/sd_page_pad"
            android:paddingEnd="@dimen/sd_page_pad"
            android:paddingBottom="@dimen/sd_space_5">

        <!-- 顶部问候 -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="5dp"
                        android:textAppearance="@style/TextAppearance.SecureDroid.Greeting"
                        android:textColor="@color/c_fg3" />
                <TextView
                        android:id="@+id/tvHomeTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_title"
                        android:textAppearance="@style/TextAppearance.SecureDroid.PageTitle"
                        android:textColor="@color/c_foreground" />
            </LinearLayout>
            <TextView
                    android:id="@+id/tvAvatar"
                    android:layout_width="@dimen/sd_avatar"
                    android:layout_height="@dimen/sd_avatar"
                    android:background="@drawable/bg_avatar"
                    android:gravity="center"
                    android:text="@string/avatar_letter"
                    android:textAppearance="@style/TextAppearance.SecureDroid.FeatureTitle"
                    android:textColor="@color/c_on_primary" />
        </LinearLayout>

        <!-- 主状态卡片 -->
        <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SecureDroid.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
            <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_hero_glow"
                        android:importantForAccessibility="no" />
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/sd_hero_pad_h"
                        android:paddingTop="@dimen/sd_hero_pad_top"
                        android:paddingEnd="@dimen/sd_hero_pad_h"
                        android:paddingBottom="@dimen/sd_hero_pad_bottom">
                    <FrameLayout
                            android:layout_width="@dimen/sd_hero_icon_wrap"
                            android:layout_height="@dimen/sd_hero_icon_wrap"
                            android:background="@drawable/bg_icon_wrap">
                        <ImageView
                                android:layout_width="@dimen/sd_hero_icon"
                                android:layout_height="@dimen/sd_hero_icon"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_sd_shield_check"
                                app:tint="@color/c_primary" />
                    </FrameLayout>
                    <TextView
                            android:id="@+id/tvHeroTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sd_space_4"
                            android:text="@string/dashboard_hero_title"
                            android:textAppearance="@style/TextAppearance.SecureDroid.HeroTitle"
                            android:textColor="@color/c_foreground" />
                    <TextView
                            android:id="@+id/tvHeroMeta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/dashboard_hero_meta_never"
                            android:textAppearance="@style/TextAppearance.SecureDroid.HeroMeta"
                            android:textColor="@color/c_muted_foreground" />
                    <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOptimize"
                            style="@style/Widget.SecureDroid.Button"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/sd_cta_height"
                            android:layout_marginTop="20dp"
                            android:text="@string/dashboard_cta_scan" />
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 状态概览条 -->
        <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SecureDroid.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">
                <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                    <TextView
                            android:id="@+id/tvStatLib"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_stat_lib_ok"
                            android:textAppearance="@style/TextAppearance.SecureDroid.StatValue"
                            android:textColor="@color/c_foreground" />
                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/dashboard_stat_lib"
                            android:textAppearance="@style/TextAppearance.SecureDroid.StatLabel"
                            android:textColor="@color/c_muted_foreground" />
                </LinearLayout>
                <View
                        android:layout_width="@dimen/sd_hairline_width"
                        android:layout_height="@dimen/sd_stat_divider"
                        android:layout_gravity="center_vertical"
                        android:background="@color/c_border" />
                <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                    <TextView
                            android:id="@+id/tvStatScanned"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sd_score_placeholder"
                            android:textAppearance="@style/TextAppearance.SecureDroid.StatValue"
                            android:textColor="@color/c_foreground" />
                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/dashboard_stat_scanned"
                            android:textAppearance="@style/TextAppearance.SecureDroid.StatLabel"
                            android:textColor="@color/c_muted_foreground" />
                </LinearLayout>
                <View
                        android:layout_width="@dimen/sd_hairline_width"
                        android:layout_height="@dimen/sd_stat_divider"
                        android:layout_gravity="center_vertical"
                        android:background="@color/c_border" />
                <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                    <TextView
                            android:id="@+id/tvStatProtected"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sd_score_placeholder"
                            android:textAppearance="@style/TextAppearance.SecureDroid.StatValue"
                            android:textColor="@color/c_foreground" />
                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/dashboard_stat_protected"
                            android:textAppearance="@style/TextAppearance.SecureDroid.StatLabel"
                            android:textColor="@color/c_muted_foreground" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 常用功能 -->
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp"
                android:text="@string/section_features"
                android:textAppearance="@style/TextAppearance.SecureDroid.Section"
                android:textColor="@color/c_section" />

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileVirus"
                    style="@style/Widget.SecureDroid.Tile"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/sd_feature_min_height"
                    android:layout_margin="5dp"
                    android:layout_weight="1">
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="@dimen/sd_tile_padding">
                    <FrameLayout
                            android:layout_width="@dimen/sd_feature_icon"
                            android:layout_height="@dimen/sd_feature_icon"
                            android:background="@drawable/bg_tint_green">
                        <ImageView
                                android:layout_width="@dimen/sd_feature_icon_inner"
                                android:layout_height="@dimen/sd_feature_icon_inner"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_sd_search"
                                app:tint="@color/c_tint_green_fg" />
                    </FrameLayout>
                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="@string/feature_scan"
                            android:textAppearance="@style/TextAppearance.SecureDroid.FeatureTitle"
                            android:textColor="@color/c_foreground" />
                    <TextView
                            android:id="@+id/tvVirusSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sd_space_1"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/feature_scan_sub"
                            android:textAppearance="@style/TextAppearance.SecureDroid.FeatureSub"
                            android:textColor="@color/c_muted_foreground" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileTrojan"
                    style="@style/Widget.SecureDroid.Tile"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/sd_feature_min_height"
                    android:layout_margin="5dp"
                    android:layout_weight="1">
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="@dimen/sd_tile_padding">
                    <FrameLayout
                            android:layout_width="@dimen/sd_feature_icon"
                            android:layout_height="@dimen/sd_feature_icon"
                            android:background="@drawable/bg_tint_amber">
                        <ImageView
                                android:layout_width="@dimen/sd_feature_icon_inner"
                                android:layout_height="@dimen/sd_feature_icon_inner"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_sd_bug"
                                app:tint="@color/c_tint_amber_fg" />
                    </FrameLayout>
                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="@string/feature_trojan"
                            android:textAppearance="@style/TextAppearance.SecureDroid.FeatureTitle"
                            android:textColor="@color/c_foreground" />
                    <TextView
                            android:id="@+id/tvTrojanSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sd_space_1"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/feature_trojan_sub"
                            android:textAppearance="@style/TextAppearance.SecureDroid.FeatureSub"
                            android:textColor="@color/c_muted_foreground" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileNetwork"
                    style="@style/Widget.SecureDroid.Tile"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/sd_feature_min_height"
                    android:layout_margin="5dp"
                    android:layout_weight="1">
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="@dimen/sd_tile_padding">
                    <FrameLayout
                            android:layout_width="@dimen/sd_feature_icon"
                            android:layout_height="@dimen/sd_feature_icon"
                            android:background="@drawable/bg_tint_blue">
                        <ImageView
                                android:layout_width="@dimen/sd_feature_icon_inner"
                                android:layout_height="@dimen/sd_feature_icon_inner"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_sd_globe"
                                app:tint="@color/c_tint_blue_fg" />
                    </FrameLayout>
                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="@string/feature_network"
                            android:textAppearance="@style/TextAppearance.SecureDroid.FeatureTitle"
                            android:textColor="@color/c_foreground" />
                    <TextView
                            android:id="@+id/tvNetworkSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sd_space_1"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/feature_network_sub"
                            android:textAppearance="@style/TextAppearance.SecureDroid.FeatureSub"
                            android:textColor="@color/c_muted_foreground" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileApplock"
                    style="@style/Widget.SecureDroid.Tile"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/sd_feature_min_height"
                    android:layout_margin="5dp"
                    android:layout_weight="1">
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="@dimen/sd_tile_padding">
                    <FrameLayout
                            android:layout_width="@dimen/sd_feature_icon"
                            android:layout_height="@dimen/sd_feature_icon"
                            android:background="@drawable/bg_tint_purple">
                        <ImageView
                                android:layout_width="@dimen/sd_feature_icon_inner"
                                android:layout_height="@dimen/sd_feature_icon_inner"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_sd_grid"
                                app:tint="@color/c_tint_purple_fg" />
                    </FrameLayout>
                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="@string/feature_applock"
                            android:textAppearance="@style/TextAppearance.SecureDroid.FeatureTitle"
                            android:textColor="@color/c_foreground" />
                    <TextView
                            android:id="@+id/tvApplockSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sd_space_1"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/feature_applock_sub"
                            android:textAppearance="@style/TextAppearance.SecureDroid.FeatureSub"
                            android:textColor="@color/c_muted_foreground" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- 最近活动 -->
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp"
                android:text="@string/section_recent"
                android:textAppearance="@style/TextAppearance.SecureDroid.Section"
                android:textColor="@color/c_section" />

        <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SecureDroid.CardList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/sd_space_4"
                        android:paddingTop="@dimen/sd_space_3"
                        android:paddingEnd="@dimen/sd_space_4"
                        android:paddingBottom="@dimen/sd_space_3">
                    <FrameLayout
                            android:layout_width="@dimen/sd_activity_icon"
                            android:layout_height="@dimen/sd_activity_icon"
                            android:background="@drawable/bg_tint_green">
                        <ImageView
                                android:layout_width="@dimen/sd_activity_icon_inner"
                                android:layout_height="@dimen/sd_activity_icon_inner"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_sd_check"
                                app:tint="@color/c_tint_green_fg" />
                    </FrameLayout>
                    <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/sd_space_3"
                            android:layout_weight="1"
                            android:orientation="vertical">
                        <TextView
                                android:id="@+id/actScanTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/activity_scan_done"
                                android:textAppearance="@style/TextAppearance.SecureDroid.ActivityTitle"
                                android:textColor="@color/c_foreground" />
                        <TextView
                                android:id="@+id/actScanTime"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/activity_scan_never"
                                android:textAppearance="@style/TextAppearance.SecureDroid.ActivityTime"
                                android:textColor="@color/c_muted_foreground" />
                    </LinearLayout>
                </LinearLayout>
                <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/sd_hairline_width"
                        android:layout_marginStart="@dimen/sd_activity_divider_inset"
                        android:layout_marginEnd="@dimen/sd_space_4"
                        android:background="@color/c_border" />
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/sd_space_4"
                        android:paddingTop="@dimen/sd_space_3"
                        android:paddingEnd="@dimen/sd_space_4"
                        android:paddingBottom="@dimen/sd_space_3">
                    <FrameLayout
                            android:layout_width="@dimen/sd_activity_icon"
                            android:layout_height="@dimen/sd_activity_icon"
                            android:background="@drawable/bg_tint_blue">
                        <ImageView
                                android:layout_width="@dimen/sd_activity_icon_inner"
                                android:layout_height="@dimen/sd_activity_icon_inner"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_sd_trash"
                                app:tint="@color/c_tint_blue_fg" />
                    </FrameLayout>
                    <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/sd_space_3"
                            android:layout_weight="1"
                            android:orientation="vertical">
                        <TextView
                                android:id="@+id/actCleanTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/activity_clean_done"
                                android:textAppearance="@style/TextAppearance.SecureDroid.ActivityTitle"
                                android:textColor="@color/c_foreground" />
                        <TextView
                                android:id="@+id/actCleanTime"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/activity_clean_sub"
                                android:textAppearance="@style/TextAppearance.SecureDroid.ActivityTime"
                                android:textColor="@color/c_muted_foreground" />
                    </LinearLayout>
                </LinearLayout>
                <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/sd_hairline_width"
                        android:layout_marginStart="@dimen/sd_activity_divider_inset"
                        android:layout_marginEnd="@dimen/sd_space_4"
                        android:background="@color/c_border" />
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/sd_space_4"
                        android:paddingTop="@dimen/sd_space_3"
                        android:paddingEnd="@dimen/sd_space_4"
                        android:paddingBottom="@dimen/sd_space_3">
                    <FrameLayout
                            android:layout_width="@dimen/sd_activity_icon"
                            android:layout_height="@dimen/sd_activity_icon"
                            android:background="@drawable/bg_tint_amber">
                        <ImageView
                                android:layout_width="@dimen/sd_activity_icon_inner"
                                android:layout_height="@dimen/sd_activity_icon_inner"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_sd_warning"
                                app:tint="@color/c_tint_amber_fg" />
                    </FrameLayout>
                    <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/sd_space_3"
                            android:layout_weight="1"
                            android:orientation="vertical">
                        <TextView
                                android:id="@+id/actRiskTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/activity_risk_perm"
                                android:textAppearance="@style/TextAppearance.SecureDroid.ActivityTitle"
                                android:textColor="@color/c_foreground" />
                        <TextView
                                android:id="@+id/actRiskTime"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/activity_risk_none"
                                android:textAppearance="@style/TextAppearance.SecureDroid.ActivityTime"
                                android:textColor="@color/c_muted_foreground" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
