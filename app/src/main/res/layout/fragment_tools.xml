<?xml version="1.0" encoding="utf-8"?>
<!-- 界面布局:可直接手改;颜色与尺寸引用 res/values 令牌(DesignRuleTest 校验触摸目标与令牌化) -->
<ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/sd_space_5">

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginBottom="10dp"
                android:text="@string/sd_section_guard"
                android:textAppearance="@style/TextAppearance.SecureDroid.Section"
                android:textColor="@color/c_section" />

        <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SecureDroid.CardList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/sd_row_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/sd_space_4"
                    android:paddingTop="@dimen/sd_space_3"
                    android:paddingEnd="@dimen/sd_space_4"
                    android:paddingBottom="@dimen/sd_space_3">
                <FrameLayout
                        android:layout_width="@dimen/sd_protection_icon"
                        android:layout_height="@dimen/sd_protection_icon"
                        android:background="@drawable/bg_tint_green">
                    <ImageView
                            android:layout_width="@dimen/sd_protection_icon_inner"
                            android:layout_height="@dimen/sd_protection_icon_inner"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_sd_shield"
                            app:tint="@color/c_tint_green_fg" />
                </FrameLayout>
                <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/sd_space_3"
                        android:layout_weight="1"
                        android:orientation="vertical">
                    <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/sw_realtime"
                            android:textAppearance="@style/TextAppearance.SecureDroid.ProtectionTitle"
                            android:textColor="@color/c_foreground" />
                    <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/sw_realtime_sub"
                            android:textAppearance="@style/TextAppearance.SecureDroid.ProtectionSub"
                            android:textColor="@color/c_muted_foreground" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swRealtime"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/sd_touch_min"
                        app:thumbTint="@color/switch_thumb"
                        app:trackTint="@color/switch_track" />
            </LinearLayout>
                <View style="@style/Widget.SecureDroid.Divider" />
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/sd_row_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/sd_space_4"
                    android:paddingTop="@dimen/sd_space_3"
                    android:paddingEnd="@dimen/sd_space_4"
                    android:paddingBottom="@dimen/sd_space_3">
                <FrameLayout
                        android:layout_width="@dimen/sd_protection_icon"
                        android:layout_height="@dimen/sd_protection_icon"
                        android:background="@drawable/bg_tint_blue">
                    <ImageView
                            android:layout_width="@dimen/sd_protection_icon_inner"
                            android:layout_height="@dimen/sd_protection_icon_inner"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_sd_zap"
                            app:tint="@color/c_tint_blue_fg" />
                </FrameLayout>
                <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/sd_space_3"
                        android:layout_weight="1"
                        android:orientation="vertical">
                    <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/sw_daily_scan"
                            android:textAppearance="@style/TextAppearance.SecureDroid.ProtectionTitle"
                            android:textColor="@color/c_foreground" />
                    <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/sw_daily_scan_sub"
                            android:textAppearance="@style/TextAppearance.SecureDroid.ProtectionSub"
                            android:textColor="@color/c_muted_foreground" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swDaily"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/sd_touch_min"
                        app:thumbTint="@color/switch_thumb"
                        app:trackTint="@color/switch_track" />
            </LinearLayout>
                <View style="@style/Widget.SecureDroid.Divider" />
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/sd_row_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/sd_space_4"
                    android:paddingTop="@dimen/sd_space_3"
                    android:paddingEnd="@dimen/sd_space_4"
                    android:paddingBottom="@dimen/sd_space_3">
                <FrameLayout
                        android:layout_width="@dimen/sd_protection_icon"
                        android:layout_height="@dimen/sd_protection_icon"
                        android:background="@drawable/bg_tint_purple">
                    <ImageView
                            android:layout_width="@dimen/sd_protection_icon_inner"
                            android:layout_height="@dimen/sd_protection_icon_inner"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_sd_info"
                            app:tint="@color/c_tint_purple_fg" />
                </FrameLayout>
                <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/sd_space_3"
                        android:layout_weight="1"
                        android:orientation="vertical">
                    <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/sw_sim_guard"
                            android:textAppearance="@style/TextAppearance.SecureDroid.ProtectionTitle"
                            android:textColor="@color/c_foreground" />
                    <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/sw_sim_guard_sub"
                            android:textAppearance="@style/TextAppearance.SecureDroid.ProtectionSub"
                            android:textColor="@color/c_muted_foreground" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swSim"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/sd_touch_min"
                        app:thumbTint="@color/switch_thumb"
                        app:trackTint="@color/switch_track" />
            </LinearLayout>
                <View style="@style/Widget.SecureDroid.Divider" />
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/sd_row_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/sd_space_4"
                    android:paddingTop="@dimen/sd_space_3"
                    android:paddingEnd="@dimen/sd_space_4"
                    android:paddingBottom="@dimen/sd_space_3">
                <FrameLayout
                        android:layout_width="@dimen/sd_protection_icon"
                        android:layout_height="@dimen/sd_protection_icon"
                        android:background="@drawable/bg_tint_amber">
                    <ImageView
                            android:layout_width="@dimen/sd_protection_icon_inner"
                            android:layout_height="@dimen/sd_protection_icon_inner"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_sd_warning"
                            app:tint="@color/c_tint_amber_fg" />
                </FrameLayout>
                <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/sd_space_3"
                        android:layout_weight="1"
                        android:orientation="vertical">
                    <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/auto_disinfect_title"
                            android:textAppearance="@style/TextAppearance.SecureDroid.ProtectionTitle"
                            android:textColor="@color/c_foreground" />
                    <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/sw_auto_disinfect_sub"
                            android:textAppearance="@style/TextAppearance.SecureDroid.ProtectionSub"
                            android:textColor="@color/c_muted_foreground" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swAutoDisinfect"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/sd_touch_min"
                        app:thumbTint="@color/switch_thumb"
                        app:trackTint="@color/switch_track" />
            </LinearLayout>
                <View style="@style/Widget.SecureDroid.Divider" />
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/sd_row_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/sd_space_4"
                    android:paddingTop="@dimen/sd_space_3"
                    android:paddingEnd="@dimen/sd_space_4"
                    android:paddingBottom="@dimen/sd_space_3">
                <FrameLayout
                        android:layout_width="@dimen/sd_protection_icon"
                        android:layout_height="@dimen/sd_protection_icon"
                        android:background="@drawable/bg_tint_amber">
                    <ImageView
                            android:layout_width="@dimen/sd_protection_icon_inner"
                            android:layout_height="@dimen/sd_protection_icon_inner"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_sd_warning"
                            app:tint="@color/c_tint_amber_fg" />
                </FrameLayout>
                <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/sd_space_3"
                        android:layout_weight="1"
                        android:orientation="vertical">
                    <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/sw_auto_uninstall"
                            android:textAppearance="@style/TextAppearance.SecureDroid.ProtectionTitle"
                            android:textColor="@color/c_foreground" />
                    <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/sw_auto_uninstall_sub"
                            android:textAppearance="@style/TextAppearance.SecureDroid.ProtectionSub"
                            android:textColor="@color/c_muted_foreground" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swAutoUninstall"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/sd_touch_min"
                        app:thumbTint="@color/switch_thumb"
                        app:trackTint="@color/switch_track" />
            </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="2dp"
                android:paddingTop="22dp"
                android:paddingEnd="2dp"
                android:paddingBottom="10dp"
                android:text="@string/root_mode_switch"
                android:textAppearance="@style/TextAppearance.SecureDroid.Section"
                android:textColor="@color/c_section" />

        <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SecureDroid.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
            <TextView
                    android:id="@+id/tvRootState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/sd_row_height"
                    android:paddingStart="@dimen/sd_space_4"
                    android:paddingTop="@dimen/sd_space_3"
                    android:paddingEnd="@dimen/sd_space_4"
                    android:paddingBottom="@dimen/sd_space_3"
                    android:text="@string/root_mode_off"
                    android:textAppearance="@style/TextAppearance.SecureDroid.ProtectionSub"
                    android:textColor="@color/c_muted_foreground" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp"
                android:text="@string/sd_section_tools"
                android:textAppearance="@style/TextAppearance.SecureDroid.Section"
                android:textColor="@color/c_section" />

        <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SecureDroid.CardList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
            <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTools"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:layoutAnimation="@anim/sd_list_layout" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
