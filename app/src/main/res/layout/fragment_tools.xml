<?xml version="1.0" encoding="utf-8"?>
<!-- 界面布局:可直接手改;颜色与尺寸引用 res/values 令牌(DesignRuleTest 校验触摸目标与令牌化) -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/sd_gutter"
            android:layout_marginTop="@dimen/sd_space_5"
            android:layout_marginBottom="@dimen/sd_space_2"
            android:text="@string/sd_section_guard"
            android:textAppearance="@style/TextAppearance.SecureDroid.Section"
            android:textColor="@color/c_muted_foreground" />
    <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SecureDroid.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
            <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swRealtime"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sd_row_height"
                    android:paddingHorizontal="@dimen/sd_space_4"
                    android:text="@string/sw_realtime"
                    android:textColor="@color/c_foreground"
                    android:textAppearance="@style/TextAppearance.SecureDroid.Body"
                    app:thumbTint="@color/switch_thumb"
                    app:trackTint="@color/switch_track" />
            <View
                    style="@style/Widget.SecureDroid.Divider" />
            <TextView
                    android:id="@+id/tvRootState"
                    style="@style/Widget.SecureDroid.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/sd_space_4"
                    android:layout_marginVertical="@dimen/sd_space_3"
                    android:text="@string/root_mode_off"
                    android:textColor="@color/c_muted_foreground" />
            <View
                    style="@style/Widget.SecureDroid.Divider" />
            <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swAutoDisinfect"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sd_row_height"
                    android:paddingHorizontal="@dimen/sd_space_4"
                    android:text="@string/sw_auto_disinfect"
                    android:textColor="@color/c_foreground"
                    android:textAppearance="@style/TextAppearance.SecureDroid.Body"
                    app:thumbTint="@color/switch_thumb"
                    app:trackTint="@color/switch_track" />
            <View
                    style="@style/Widget.SecureDroid.Divider" />
            <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swAutoUninstall"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sd_row_height"
                    android:paddingHorizontal="@dimen/sd_space_4"
                    android:text="@string/sw_auto_uninstall"
                    android:textColor="@color/c_foreground"
                    android:textAppearance="@style/TextAppearance.SecureDroid.Body"
                    app:thumbTint="@color/switch_thumb"
                    app:trackTint="@color/switch_track" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/sd_gutter"
            android:layout_marginTop="@dimen/sd_space_5"
            android:layout_marginBottom="@dimen/sd_space_2"
            android:text="@string/sd_section_prefs"
            android:textAppearance="@style/TextAppearance.SecureDroid.Section"
            android:textColor="@color/c_muted_foreground" />
    <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SecureDroid.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
            <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swDaily"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sd_row_height"
                    android:paddingHorizontal="@dimen/sd_space_4"
                    android:text="@string/sw_daily_scan"
                    android:textColor="@color/c_foreground"
                    android:textAppearance="@style/TextAppearance.SecureDroid.Body"
                    app:thumbTint="@color/switch_thumb"
                    app:trackTint="@color/switch_track" />
            <View
                    style="@style/Widget.SecureDroid.Divider" />
            <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swSim"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sd_row_height"
                    android:paddingHorizontal="@dimen/sd_space_4"
                    android:text="@string/sw_sim_guard"
                    android:textColor="@color/c_foreground"
                    android:textAppearance="@style/TextAppearance.SecureDroid.Body"
                    app:thumbTint="@color/switch_thumb"
                    app:trackTint="@color/switch_track" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/sd_gutter"
            android:layout_marginTop="@dimen/sd_space_5"
            android:layout_marginBottom="@dimen/sd_space_2"
            android:text="@string/sd_section_tools"
            android:textAppearance="@style/TextAppearance.SecureDroid.Section"
            android:textColor="@color/c_muted_foreground" />
    <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SecureDroid.Card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTools"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:layoutAnimation="@anim/sd_list_layout" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
