<?xml version="1.0" encoding="utf-8"?>
<!-- 工具箱(iOS 风格):开关一张分组卡,工具明细一张分组卡 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/sd_gutter"
        android:layout_marginBottom="@dimen/sd_space_2"
        android:text="@string/sd_section_prefs"
        android:textAppearance="@style/TextAppearance.SecureDroid.Section"
        android:textColor="@color/sd_text_secondary" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.SecureDroid.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swDaily"
                android:layout_width="match_parent"
                android:layout_height="@dimen/sd_row_height"
                android:paddingHorizontal="@dimen/sd_gutter"
                android:text="@string/sw_daily_scan"
                android:textColor="@color/sd_text"
                android:textSize="17sp"
                app:thumbTint="@color/switch_thumb"
                app:trackTint="@color/switch_track" />

            <View style="@style/Widget.SecureDroid.Divider" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swSim"
                android:layout_width="match_parent"
                android:layout_height="@dimen/sd_row_height"
                android:paddingHorizontal="@dimen/sd_gutter"
                android:text="@string/sw_sim_guard"
                android:textColor="@color/sd_text"
                android:textSize="17sp"
                app:thumbTint="@color/switch_thumb"
                app:trackTint="@color/switch_track" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/sd_gutter"
        android:layout_marginTop="@dimen/sd_space_5"
        android:layout_marginBottom="@dimen/sd_space_2"
        android:text="@string/sd_section_tools"
        android:textAppearance="@style/TextAppearance.SecureDroid.Section"
        android:textColor="@color/sd_text_secondary" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.SecureDroid.Card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTools"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false" />
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>