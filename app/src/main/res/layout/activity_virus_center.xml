<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceTitleLarge" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.42"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vc_recent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmbedded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                style="?attr/materialButtonOutlinedStyle"
                android:text="@string/vc_embedded" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDiff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                style="?attr/materialButtonOutlinedStyle"
                android:text="@string/vc_diff" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResidue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                style="?attr/materialButtonOutlinedStyle"
                android:text="@string/vc_residue" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNewProc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                style="?attr/materialButtonOutlinedStyle"
                android:text="@string/vc_newproc" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLearn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                style="?attr/materialButtonOutlinedStyle"
                android:text="@string/vc_learn" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                style="?attr/materialButtonOutlinedStyle"
                android:text="@string/vc_stats" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSig"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                style="?attr/materialButtonOutlinedStyle"
                android:text="@string/vc_sig" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpdate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                style="?attr/materialButtonOutlinedStyle"
                android:text="@string/vc_update" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuarantine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                style="?attr/materialButtonOutlinedStyle"
                android:text="@string/vc_quarantine" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTrust"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                style="?attr/materialButtonOutlinedStyle"
                android:text="@string/vc_trust" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                style="?attr/materialButtonOutlinedStyle"
                android:text="@string/vc_report" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/tvPhase"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="?android:attr/progressBarStyleHorizontal"
        android:indeterminate="true" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.58"
        android:layout_marginTop="8dp" />
</LinearLayout>
