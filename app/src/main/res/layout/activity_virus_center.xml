<?xml version="1.0" encoding="utf-8"?>
<!-- 病毒查杀中心:主页玻璃拟态风格 —— 顶部返回栏 + 动作菜单/查杀运行态切换 -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/sd_gutter"
        android:paddingTop="@dimen/sd_space_2">

    <!-- 顶部返回栏 -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
        <ImageButton
                android:id="@+id/btnTopBack"
                android:layout_width="@dimen/sd_touch_min"
                android:layout_height="@dimen/sd_touch_min"
                android:background="@drawable/bg_icon_wrap"
                android:contentDescription="@string/nav_back"
                android:padding="@dimen/sd_space_3"
                android:scaleType="centerInside"
                android:src="@drawable/ic_sd_back" />
        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/sd_space_3"
                android:layout_weight="1"
                android:orientation="vertical">
            <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/vc_title"
                    android:textAppearance="@style/TextAppearance.SecureDroid.PageTitle"
                    android:textColor="@color/c_foreground" />
            <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sd_space_1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/vc_subtitle"
                    android:textAppearance="@style/TextAppearance.SecureDroid.Caption"
                    android:textColor="@color/c_muted_foreground" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/sd_space_3"
            android:layout_marginBottom="@dimen/sd_space_4"
            android:layout_weight="1">

        <!-- 菜单态:查杀动作列表 -->
        <LinearLayout
                android:id="@+id/menuState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
            <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.SecureDroid.Card"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvActions"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:layoutAnimation="@anim/sd_list_layout" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- 运行态:控制按钮 + 进度 + 结果列表 -->
        <LinearLayout
                android:id="@+id/runState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">
            <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.SecureDroid.Card"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="@dimen/sd_space_4">
                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnBack"
                                style="@style/Widget.SecureDroid.Button"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/sd_btn_height"
                                android:layout_weight="1"
                                android:text="@string/vc_back" />
                        <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCancel"
                                style="@style/Widget.SecureDroid.Button.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/sd_btn_height"
                                android:layout_marginStart="@dimen/sd_space_2"
                                android:layout_weight="1"
                                android:text="@string/vc_cancel" />
                    </LinearLayout>
                    <ProgressBar
                            android:id="@+id/progress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/sd_progress_height"
                            android:layout_marginTop="@dimen/sd_space_4"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/progress_fluid" />
                    <TextView
                            android:id="@+id/tvPhase"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sd_space_3"
                            android:textAppearance="@style/TextAppearance.SecureDroid.Label"
                            android:textColor="@color/c_muted_foreground" />
                    <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvList"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="@dimen/sd_space_3"
                            android:layout_weight="1"
                            android:clipToPadding="false"
                            android:layoutAnimation="@anim/sd_list_layout" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>