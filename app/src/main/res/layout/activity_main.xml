<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 完整性告警条:默认隐藏,仅在签名校验失败(疑似重打包)时由 MainActivity 显示 -->
    <TextView
        android:id="@+id/integrityBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#B3261E"
        android:padding="12dp"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:titleTextColor="#FFFFFF"
        app:title="@string/app_name" />

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 6 个功能入口。Material 的 BottomNavigationView 硬上限为 5 项,
         超过会在膨胀阶段抛 IllegalArgumentException(BottomNavigationView#getMaxItemCount),
         导致主界面无法启动。TabLayout 滚动模式无此限制,且内置选中态与图标支持。 -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:tabMode="scrollable"
        app:tabGravity="fill"
        app:tabIndicatorHeight="3dp"
        app:tabInlineLabel="true" />
</LinearLayout>
