<?xml version="1.0" encoding="utf-8"?>
<!--
  应用外壳:内容层(容器)+ 功能层(工具栏、底部入口条)。
  设计依据(HIG):玻璃材质只出现在浮于内容之上的控件层;内容层使用凝光渐变背景,保持可读性。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_fluid"
    android:orientation="vertical">

    <!-- 完整性告警条:签名与首次安装不一致(疑似重打包)时由 MainActivity 显示 -->
    <TextView
        android:id="@+id/integrityBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sd_danger_solid"
        android:padding="@dimen/sd_space_3"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/sd_glass"
        android:elevation="0dp"
        app:title="@string/app_name"
        app:titleTextAppearance="@style/TextAppearance.SecureDroid.Title"
        app:titleTextColor="@color/sd_text" />

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 底部入口条:功能层玻璃面板 + 顶部 3dp 胶囊指示器。
         Material 的 BottomNavigationView 硬上限为 5 项,本应用有 6 个入口,
         使用可滚动 TabLayout 避免膨胀期抛异常。 -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_panel"
        android:minHeight="64dp"
        app:tabGravity="fill"
        app:tabIconTint="@color/tab_text"
        app:tabIndicator="@drawable/tab_indicator"
        app:tabIndicatorColor="@color/sd_brand"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorGravity="top"
        app:tabIndicatorHeight="3dp"
        app:tabInlineLabel="true"
        app:tabMode="scrollable"
        app:tabPaddingEnd="@dimen/sd_space_3"
        app:tabPaddingStart="@dimen/sd_space_3"
        app:tabRippleColor="@color/sd_hairline_soft"
        app:tabTextColor="@color/tab_text" />
</LinearLayout>