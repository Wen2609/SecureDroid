<?xml version="1.0" encoding="utf-8"?>
<!-- 主界面 = WebView 渲染上传稿 HTML(assets/ui/index.html),全部交互经 JS 桥接原生功能;
     颜色与尺寸引用 res/values 令牌(DesignRuleTest 校验触摸目标与令牌化) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    <TextView
            android:id="@+id/integrityBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginHorizontal="@dimen/sd_gutter"
            android:layout_marginTop="@dimen/sd_space_2"
            android:background="@drawable/bg_integrity_banner"
            android:drawableStart="@drawable/ic_sd_warning"
            android:drawablePadding="@dimen/sd_space_2"
            android:drawableTint="@color/c_destructive"
            android:ellipsize="end"
            android:maxLines="3"
            android:gravity="center_vertical"
            android:padding="@dimen/sd_space_3"
            android:textAppearance="@style/TextAppearance.SecureDroid.Caption"
            android:textColor="@color/c_destructive"
            android:visibility="gone" />

    <!-- 启动品牌遮罩:冷启动时显示盾牌 Logo + 应用名,WebView 首帧就绪后淡出,
         避免白屏闪烁,与窗口 bg_page 渐变背景无缝衔接 -->
    <FrameLayout
            android:id="@+id/splashOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_page">

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center_horizontal">

            <ImageView
                    android:layout_width="@dimen/sd_hero_icon_wrap"
                    android:layout_height="@dimen/sd_hero_icon_wrap"
                    android:src="@drawable/ic_launcher_foreground"
                    android:contentDescription="@string/app_name" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sd_space_4"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.SecureDroid.Title"
                    android:textColor="@color/c_foreground" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sd_space_1"
                    android:text="@string/splash_subtitle"
                    android:textAppearance="@style/TextAppearance.SecureDroid.Caption"
                    android:textColor="@color/c_muted_foreground" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
