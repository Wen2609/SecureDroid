<?xml version="1.0" encoding="utf-8"?>
<!-- 深度查杀:主页玻璃拟态风格 —— 顶部返回栏 + 操作进度卡 + 结果列表卡 -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/sd_gutter"
        android:paddingTop="@dimen/sd_space_2">

    <!-- 顶部返回栏 -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
        <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="@dimen/sd_touch_min"
                android:layout_height="@dimen/sd_touch_min"
                android:background="@drawable/bg_icon_wrap"
                android:contentDescription="@string/nav_back"
                android:padding="@dimen/sd_space_3"
                android:scaleType="centerInside"
                android:src="@drawable/ic_sd_back" />
        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/sd_space_3"
                android:layout_weight="1"
                android:orientation="vertical">
            <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/deep_scan_title"
                    android:textAppearance="@style/TextAppearance.SecureDroid.PageTitle"
                    android:textColor="@color/c_foreground" />
            <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sd_space_1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/deep_subtitle"
                    android:textAppearance="@style/TextAppearance.SecureDroid.Caption"
                    android:textColor="@color/c_muted_foreground" />
        </LinearLayout>
    </LinearLayout>

    <!-- 操作与进度卡 -->
    <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SecureDroid.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sd_space_3">
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/sd_space_4">
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                <FrameLayout
                        android:layout_width="@dimen/sd_hero_icon_wrap"
                        android:layout_height="@dimen/sd_hero_icon_wrap"
                        android:background="@drawable/bg_icon_wrap">
                    <ImageView
                            android:layout_width="@dimen/sd_scan_icon"
                            android:layout_height="@dimen/sd_scan_icon"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_scan"
                            app:tint="@color/c_on_primary" />
                </FrameLayout>
                <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/sd_space_3"
                        android:layout_weight="1"
                        android:orientation="vertical">
                    <TextView
                            android:id="@+id/tvPhase"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="3"
                            android:text="@string/deep_note"
                            android:textAppearance="@style/TextAppearance.SecureDroid.Label"
                            android:textColor="@color/c_muted_foreground" />
                    <ProgressBar
                            android:id="@+id/progress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/sd_progress_height"
                            android:layout_marginTop="@dimen/sd_space_2"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/progress_fluid" />
                </LinearLayout>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStart"
                    style="@style/Widget.SecureDroid.Button.Accent"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sd_btn_height"
                    android:layout_marginTop="@dimen/sd_space_4"
                    android:text="@string/deep_btn_start"
                    app:icon="@drawable/ic_scan" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 结果列表卡 -->
    <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SecureDroid.Card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/sd_space_3"
            android:layout_marginBottom="@dimen/sd_space_4"
            android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:layoutAnimation="@anim/sd_list_layout" />
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>