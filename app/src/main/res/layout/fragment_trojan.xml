<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTrojanScan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/trojan_start" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRootkit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        style="?attr/materialButtonOutlinedStyle"
        android:text="@string/rootkit_btn" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnModules"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        style="?attr/materialButtonOutlinedStyle"
        android:text="@string/modules_btn" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLocker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        style="?attr/materialButtonOutlinedStyle"
        android:text="@string/locker_btn" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDeepScan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        style="?attr/materialButtonOutlinedStyle"
        android:text="@string/deep_scan_btn" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        style="?android:attr/progressBarStyleHorizontal"
        android:max="100"
        android:progress="0" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/trojan_idle"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTrojan"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp" />
</LinearLayout>
