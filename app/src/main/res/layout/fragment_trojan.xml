<?xml version="1.0" encoding="utf-8"?>
<!--
  木马查杀页:一个主行动(最常用的全盘查杀)+ 四个次级扫描 + 一个入口。
  主次分明比"六个同等按钮堆叠"更快被理解,也符合"色彩只用于主行动"的克制原则。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/sd_gutter"
    android:paddingTop="@dimen/sd_space_4">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.SecureDroid.CardGlass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/sd_space_4">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTrojanScan"
                style="@style/Widget.SecureDroid.Button.Pill"
                android:layout_width="match_parent"
                android:layout_height="@dimen/sd_btn_height"
                android:text="@string/trojan_start"
                app:icon="@drawable/ic_bug" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sd_space_4"
                android:layout_marginBottom="@dimen/sd_space_2"
                android:text="@string/sd_section_trojan"
                android:textAppearance="@style/TextAppearance.SecureDroid.Section"
                android:textColor="@color/sd_text_tertiary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRootkit"
                    style="@style/Widget.SecureDroid.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="2"
                    android:minHeight="56dp"
                    android:text="@string/rootkit_btn"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModules"
                    style="@style/Widget.SecureDroid.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/sd_space_2"
                    android:layout_weight="1"
                    android:maxLines="2"
                    android:minHeight="56dp"
                    android:text="@string/modules_btn"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sd_space_2"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLocker"
                    style="@style/Widget.SecureDroid.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="2"
                    android:minHeight="56dp"
                    android:text="@string/locker_btn"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeepScan"
                    style="@style/Widget.SecureDroid.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/sd_space_2"
                    android:layout_weight="1"
                    android:maxLines="2"
                    android:minHeight="56dp"
                    android:text="@string/deep_scan_btn"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVirusCenter"
                style="@style/Widget.SecureDroid.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="@dimen/sd_touch_min"
                android:layout_marginTop="@dimen/sd_space_2"
                android:text="@string/vc_open_btn" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="@dimen/sd_space_4"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/progress_fluid" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sd_space_3"
        android:text="@string/trojan_idle"
        android:textAppearance="@style/TextAppearance.SecureDroid.Body"
        android:textColor="@color/sd_text_secondary" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTrojan"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layoutAnimation="@anim/sd_list_layout"
        android:layout_marginTop="@dimen/sd_space_3"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/sd_space_5" />
</LinearLayout>