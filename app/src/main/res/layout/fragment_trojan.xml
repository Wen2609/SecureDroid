<?xml version="1.0" encoding="utf-8"?>
<!--
  木马查杀(检测板块的第二个分段)。上一版是 6 个等价按钮堆叠 —— 那是典型的"按钮墙",
  用户无法一眼判断该按哪个。现在只有一个主行动 + 一行次级入口。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.SecureDroid.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/sd_space_4">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTrojanScan"
                style="@style/Widget.SecureDroid.Button.Pill"
                android:layout_width="match_parent"
                android:layout_height="@dimen/sd_btn_height"
                android:text="@string/trojan_start"
                app:icon="@drawable/ic_bug" />

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="@dimen/sd_space_4"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/progress_fluid" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sd_space_3"
                android:text="@string/trojan_idle"
                android:textAppearance="@style/TextAppearance.SecureDroid.Label"
                android:textColor="@color/sd_text_secondary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.SecureDroid.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sd_space_3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/sd_space_2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRootkit"
                style="@style/Widget.SecureDroid.Button.Row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/sd_row_height"
                android:text="@string/rootkit_btn"
                app:icon="@drawable/ic_shield" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModules"
                style="@style/Widget.SecureDroid.Button.Row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/sd_row_height"
                android:text="@string/modules_btn"
                app:icon="@drawable/ic_grid" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLocker"
                style="@style/Widget.SecureDroid.Button.Row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/sd_row_height"
                android:text="@string/locker_btn"
                app:icon="@drawable/ic_lock" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeepScan"
                style="@style/Widget.SecureDroid.Button.Row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/sd_row_height"
                android:text="@string/deep_scan_btn"
                app:icon="@drawable/ic_scan" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVirusCenter"
                style="@style/Widget.SecureDroid.Button.Row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/sd_row_height"
                android:text="@string/vc_open_btn"
                app:icon="@drawable/ic_bug" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTrojan"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layoutAnimation="@anim/sd_list_layout"
        android:layout_marginTop="@dimen/sd_space_3"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/sd_space_5" />
</LinearLayout>