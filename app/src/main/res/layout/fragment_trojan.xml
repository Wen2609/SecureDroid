<?xml version="1.0" encoding="utf-8"?>
<!-- 界面布局:可直接手改;颜色与尺寸引用 res/values 令牌(DesignRuleTest 校验触摸目标与令牌化) -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
    <!-- 查杀主面板 -->
    <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SecureDroid.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sd_space_4">
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/sd_hero_pad_h"
                android:paddingTop="@dimen/sd_hero_pad_top"
                android:paddingEnd="@dimen/sd_hero_pad_h"
                android:paddingBottom="@dimen/sd_hero_pad_bottom">
            <FrameLayout
                    android:layout_width="@dimen/sd_scan_circle"
                    android:layout_height="@dimen/sd_scan_circle"
                    android:background="@drawable/bg_scan_circle">
                <ImageView
                        android:layout_width="@dimen/sd_scan_icon"
                        android:layout_height="@dimen/sd_scan_icon"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_sd_bug"
                        app:tint="@color/c_primary" />
            </FrameLayout>
            <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="18dp"
                    android:gravity="center"
                    android:text="@string/trojan_idle"
                    android:textAppearance="@style/TextAppearance.SecureDroid.ScanHint"
                    android:textColor="@color/c_muted_foreground" />
            <ProgressBar
                    android:id="@+id/progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sd_progress_height"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_fluid" />
            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTrojanScan"
                    style="@style/Widget.SecureDroid.Button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sd_cta_height"
                    android:layout_marginTop="18dp"
                    android:text="@string/trojan_start"
                    app:icon="@drawable/ic_sd_bug" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 专项检测入口 -->
    <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SecureDroid.CardList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sd_space_4">
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
            <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sd_row_height">
                <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRootkit"
                        style="@style/Widget.SecureDroid.Button.Row"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/rootkit_btn" />
                <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="@dimen/sd_space_4"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_sd_chevron"
                        app:tint="@color/c_muted_foreground" />
            </FrameLayout>
            <View style="@style/Widget.SecureDroid.Divider" />
            <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sd_row_height">
                <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModules"
                        style="@style/Widget.SecureDroid.Button.Row"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/modules_btn" />
                <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="@dimen/sd_space_4"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_sd_chevron"
                        app:tint="@color/c_muted_foreground" />
            </FrameLayout>
            <View style="@style/Widget.SecureDroid.Divider" />
            <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sd_row_height">
                <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLocker"
                        style="@style/Widget.SecureDroid.Button.Row"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/locker_btn" />
                <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="@dimen/sd_space_4"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_sd_chevron"
                        app:tint="@color/c_muted_foreground" />
            </FrameLayout>
            <View style="@style/Widget.SecureDroid.Divider" />
            <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sd_row_height">
                <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDeepScan"
                        style="@style/Widget.SecureDroid.Button.Row"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/deep_scan_btn" />
                <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="@dimen/sd_space_4"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_sd_chevron"
                        app:tint="@color/c_muted_foreground" />
            </FrameLayout>
            <View style="@style/Widget.SecureDroid.Divider" />
            <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sd_row_height">
                <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVirusCenter"
                        style="@style/Widget.SecureDroid.Button.Row"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/vc_open_btn" />
                <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="@dimen/sd_space_4"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_sd_chevron"
                        app:tint="@color/c_muted_foreground" />
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 木马检测结果 -->
    <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SecureDroid.Card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/sd_space_4"
            android:layout_weight="1">
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/sd_space_4"
                    android:paddingTop="14dp"
                    android:paddingEnd="@dimen/sd_space_4"
                    android:paddingBottom="@dimen/sd_space_3"
                    android:text="@string/trojan_results_head"
                    android:textAppearance="@style/TextAppearance.SecureDroid.CardHead"
                    android:textColor="@color/c_section" />
            <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sd_hairline_width"
                    android:background="@color/c_border" />
            <TextView
                    android:id="@+id/tvEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingStart="@dimen/sd_space_4"
                    android:paddingTop="32dp"
                    android:paddingEnd="@dimen/sd_space_4"
                    android:paddingBottom="32dp"
                    android:text="@string/trojan_empty"
                    android:textAppearance="@style/TextAppearance.SecureDroid.EmptyHint"
                    android:textColor="@color/c_muted_foreground" />
            <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTrojan"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:layoutAnimation="@anim/sd_list_layout" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
