<?xml version="1.0" encoding="utf-8"?>
<!-- 界面布局:可直接手改;颜色与尺寸引用 res/values 令牌(DesignRuleTest 校验触摸目标与令牌化) -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/sd_row_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/sd_space_4"
        android:paddingEnd="@dimen/sd_space_2"
        android:paddingVertical="@dimen/sd_space_2">
    <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
        <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.SecureDroid.Body"
                android:textColor="@color/c_foreground" />
        <TextView
                android:id="@+id/tvPkg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.SecureDroid.Label"
                android:textColor="@color/c_muted_foreground" />
        </LinearLayout>
    <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swLock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/sd_touch_min"
            app:thumbTint="@color/switch_thumb"
            app:trackTint="@color/switch_track" />
    </LinearLayout>
