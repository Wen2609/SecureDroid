<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.SecureDroid.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/sd_space_2"
    app:cardCornerRadius="@dimen/sd_radius_inner">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/sd_touch_min"
        android:orientation="horizontal"
        android:paddingStart="@dimen/sd_space_4"
        android:paddingEnd="@dimen/sd_space_3"
        android:paddingVertical="@dimen/sd_space_2">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.SecureDroid.Body"
                android:textColor="@color/sd_text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPkg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.SecureDroid.Label"
                android:textColor="@color/sd_text_tertiary" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swLock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/sd_touch_min" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>