<?xml version="1.0" encoding="utf-8"?>
<!-- 应用锁页:PIN 状态用胶囊表达状态,主行动(设置 PIN)最显眼 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.SecureDroid.CardGlass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/sd_space_4">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sd_section_lock"
                android:textAppearance="@style/TextAppearance.SecureDroid.Section"
                android:textColor="@color/sd_text_tertiary" />

            <TextView
                android:id="@+id/tvPinState"
                style="@style/Widget.SecureDroid.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sd_space_3"
                android:textColor="@color/sd_text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetPin"
                style="@style/Widget.SecureDroid.Button.Pill"
                android:layout_width="match_parent"
                android:layout_height="@dimen/sd_btn_height"
                android:layout_marginTop="@dimen/sd_space_4"
                android:text="@string/lock_set_pin"
                app:icon="@drawable/ic_lock" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swDecoy"
                android:layout_width="match_parent"
                android:layout_height="@dimen/sd_touch_min"
                android:layout_marginTop="@dimen/sd_space_2"
                android:text="@string/lock_decoy_sw"
                android:textColor="@color/sd_text" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAccessibility"
        style="@style/Widget.SecureDroid.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="@dimen/sd_touch_min"
        android:layout_marginTop="@dimen/sd_space_3"
        android:text="@string/lock_accessibility_go" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLockApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layoutAnimation="@anim/sd_list_layout"
        android:layout_marginTop="@dimen/sd_space_4"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/sd_space_5" />
</LinearLayout>