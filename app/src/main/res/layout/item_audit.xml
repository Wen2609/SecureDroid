<?xml version="1.0" encoding="utf-8"?>
<!-- 界面布局:可直接手改;颜色与尺寸引用 res/values 令牌(DesignRuleTest 校验触摸目标与令牌化) -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/sd_space_4"
        android:paddingVertical="@dimen/sd_space_3">
    <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
        <TextView
                android:id="@+id/tvAppName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.SecureDroid.RowTitle"
                android:textColor="@color/c_foreground" />
        <TextView
                android:id="@+id/tvPerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.SecureDroid.RowSub"
                android:textColor="@color/c_muted_foreground" />
        </LinearLayout>
    <TextView
            android:id="@+id/tvScore"
            style="@style/Widget.SecureDroid.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/sd_space_3"
            android:background="@drawable/bg_badge"
            android:textAppearance="@style/TextAppearance.SecureDroid.Badge"
            android:textColor="@color/c_muted_foreground" />
    </LinearLayout>
