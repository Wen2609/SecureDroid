<?xml version="1.0" encoding="utf-8"?>
<!-- 检测板块:分段控件切换二级功能,内容区承载子页面 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/sd_gutter">

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/segDetect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sd_space_3"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/segDetectVirus"
            style="@style/Widget.SecureDroid.Segment"
            android:layout_width="0dp"
            android:layout_height="@dimen/sd_touch_min"
            android:layout_weight="1"
            android:text="@string/seg_virus" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/segDetectTrojan"
            style="@style/Widget.SecureDroid.Segment"
            android:layout_width="0dp"
            android:layout_height="@dimen/sd_touch_min"
            android:layout_weight="1"
            android:text="@string/seg_trojan" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <FrameLayout
        android:id="@+id/detectContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/sd_space_4"
        android:layout_weight="1" />
</LinearLayout>