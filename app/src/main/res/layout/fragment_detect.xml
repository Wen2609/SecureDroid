<?xml version="1.0" encoding="utf-8"?>
<!-- 界面布局:可直接手改;颜色与尺寸引用 res/values 令牌(DesignRuleTest 校验触摸目标与令牌化) -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/sd_page_pad"
        android:paddingEnd="@dimen/sd_page_pad">
    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/tab_detect"
            android:textAppearance="@style/TextAppearance.SecureDroid.PageTitle"
            android:textColor="@color/c_foreground" />
    <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/segDetect"
            style="@style/Widget.SecureDroid.SegmentTrack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sd_space_4"
            app:selectionRequired="true"
            app:singleSelection="true">
        <com.google.android.material.button.MaterialButton
                android:id="@+id/segDetectVirus"
                style="@style/Widget.SecureDroid.Segment"
                android:layout_width="0dp"
                android:layout_height="@dimen/sd_seg_height"
                android:layout_weight="1"
                android:text="@string/seg_virus" />
        <com.google.android.material.button.MaterialButton
                android:id="@+id/segDetectTrojan"
                style="@style/Widget.SecureDroid.Segment"
                android:layout_width="0dp"
                android:layout_height="@dimen/sd_seg_height"
                android:layout_weight="1"
                android:text="@string/seg_trojan" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
    <FrameLayout
            android:id="@+id/detectContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/sd_space_4"
            android:layout_weight="1" />
</LinearLayout>
