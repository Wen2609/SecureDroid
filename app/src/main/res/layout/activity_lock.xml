<?xml version="1.0" encoding="utf-8"?>
<!-- 界面布局:可直接手改;颜色与尺寸引用 res/values 令牌(DesignRuleTest 校验触摸目标与令牌化) -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/sd_space_5">
        <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/lock_unlock_title"
                android:src="@drawable/ic_lock"
                app:tint="@color/c_accent" />
        <TextView
                android:id="@+id/tvDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sd_space_4"
                android:layout_marginBottom="@dimen/sd_space_5"
                android:letterSpacing="0.4"
                android:minHeight="@dimen/sd_touch_min"
                android:text="@string/lock_unlock_hint"
                android:textColor="@color/c_muted_foreground"
                android:textAppearance="@style/TextAppearance.SecureDroid.Body" />
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn1"
                    style="@style/Widget.SecureDroid.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_margin="@dimen/sd_space_1"
                    android:layout_weight="1"
                    android:text="@string/keypad_1"
                    android:textAppearance="@style/TextAppearance.SecureDroid.Keypad" />
            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn2"
                    style="@style/Widget.SecureDroid.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_margin="@dimen/sd_space_1"
                    android:layout_weight="1"
                    android:text="@string/keypad_2"
                    android:textAppearance="@style/TextAppearance.SecureDroid.Keypad" />
            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn3"
                    style="@style/Widget.SecureDroid.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_margin="@dimen/sd_space_1"
                    android:layout_weight="1"
                    android:text="@string/keypad_3"
                    android:textAppearance="@style/TextAppearance.SecureDroid.Keypad" />
            </LinearLayout>
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn4"
                    style="@style/Widget.SecureDroid.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_margin="@dimen/sd_space_1"
                    android:layout_weight="1"
                    android:text="@string/keypad_4"
                    android:textAppearance="@style/TextAppearance.SecureDroid.Keypad" />
            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn5"
                    style="@style/Widget.SecureDroid.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_margin="@dimen/sd_space_1"
                    android:layout_weight="1"
                    android:text="@string/keypad_5"
                    android:textAppearance="@style/TextAppearance.SecureDroid.Keypad" />
            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn6"
                    style="@style/Widget.SecureDroid.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_margin="@dimen/sd_space_1"
                    android:layout_weight="1"
                    android:text="@string/keypad_6"
                    android:textAppearance="@style/TextAppearance.SecureDroid.Keypad" />
            </LinearLayout>
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn7"
                    style="@style/Widget.SecureDroid.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_margin="@dimen/sd_space_1"
                    android:layout_weight="1"
                    android:text="@string/keypad_7"
                    android:textAppearance="@style/TextAppearance.SecureDroid.Keypad" />
            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn8"
                    style="@style/Widget.SecureDroid.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_margin="@dimen/sd_space_1"
                    android:layout_weight="1"
                    android:text="@string/keypad_8"
                    android:textAppearance="@style/TextAppearance.SecureDroid.Keypad" />
            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn9"
                    style="@style/Widget.SecureDroid.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_margin="@dimen/sd_space_1"
                    android:layout_weight="1"
                    android:text="@string/keypad_9"
                    android:textAppearance="@style/TextAppearance.SecureDroid.Keypad" />
            </LinearLayout>
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
            <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />
            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn0"
                    style="@style/Widget.SecureDroid.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_margin="@dimen/sd_space_1"
                    android:layout_weight="1"
                    android:text="@string/keypad_0"
                    android:textAppearance="@style/TextAppearance.SecureDroid.Keypad" />
            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDel"
                    style="@style/Widget.SecureDroid.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_margin="@dimen/sd_space_1"
                    android:layout_weight="1"
                    android:contentDescription="@string/lock_unlock_hint"
                    app:icon="@drawable/ic_backspace"
                    app:iconGravity="textStart" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
