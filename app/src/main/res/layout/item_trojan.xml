<?xml version="1.0" encoding="utf-8"?>
<!-- 查杀结果项:左侧风险色条 + 内容列(主页玻璃列表风格) -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/sd_row_height"
        android:orientation="horizontal"
        android:padding="@dimen/sd_space_4">
    <View
            android:id="@+id/vRiskBar"
            android:layout_width="@dimen/sd_space_1"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/sd_space_3"
            android:background="@drawable/bg_risk_bar_safe" />
    <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
        <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.SecureDroid.RowTitle"
                android:textColor="@color/c_foreground" />
        <TextView
                android:id="@+id/tvSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sd_space_1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.SecureDroid.RowSub"
                android:textColor="@color/c_muted_foreground" />
        <TextView
                android:id="@+id/tvDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sd_space_2"
                android:ellipsize="end"
                android:maxLines="3"
                android:textAppearance="@style/TextAppearance.SecureDroid.Label"
                android:textColor="@color/c_muted_foreground" />
        <TextView
                android:id="@+id/tvSuggestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sd_space_2"
                android:ellipsize="end"
                android:maxLines="3"
                android:textAppearance="@style/TextAppearance.SecureDroid.Label"
                android:textColor="@color/c_accent" />
        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sd_space_2"
                android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUninstall"
                    style="@style/Widget.SecureDroid.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/sd_space_2"
                    android:minHeight="@dimen/sd_touch_min"
                    android:text="@string/trojan_uninstall" />
            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFix"
                    style="@style/Widget.SecureDroid.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/sd_touch_min"
                    android:text="@string/fix_run" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>