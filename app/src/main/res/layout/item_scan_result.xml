<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/sd_row_height"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/sd_gutter"
    android:paddingVertical="@dimen/sd_space_3">

    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.SecureDroid.Headline"
        android:textColor="@color/sd_text" />

    <TextView
        android:id="@+id/tvPackage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.SecureDroid.Label"
        android:textColor="@color/sd_text_secondary" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.SecureDroid.Label"
        android:textColor="@color/sd_text_secondary" />
</LinearLayout>