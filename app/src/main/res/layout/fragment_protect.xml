<?xml version="1.0" encoding="utf-8"?>
<!-- 由 design/generate_layouts.mjs 从设计令牌生成;请勿手改,改令牌或改脚本后重跑 -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/sd_gutter">
    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sd_space_4"
            android:text="@string/tab_protect"
            android:textAppearance="@style/TextAppearance.SecureDroid.Title"
            android:textColor="@color/c_foreground" />
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sd_space_4"
            android:background="@drawable/bg_segment_track"
            android:padding="2dp">
        <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/segProtect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">
            <com.google.android.material.button.MaterialButton
                    android:id="@+id/segProtectLock"
                    style="@style/Widget.SecureDroid.Segment"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/sd_segment_hit"
                    android:layout_weight="1"
                    android:text="@string/seg_applock" />
            <com.google.android.material.button.MaterialButton
                    android:id="@+id/segProtectAudit"
                    style="@style/Widget.SecureDroid.Segment"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/sd_segment_hit"
                    android:layout_weight="1"
                    android:text="@string/seg_audit" />
            <com.google.android.material.button.MaterialButton
                    android:id="@+id/segProtectTools"
                    style="@style/Widget.SecureDroid.Segment"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/sd_segment_hit"
                    android:layout_weight="1"
                    android:text="@string/seg_tools" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>
    <FrameLayout
            android:id="@+id/protectContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/sd_space_4"
            android:layout_weight="1" />
    </LinearLayout>
