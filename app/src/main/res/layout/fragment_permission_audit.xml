<?xml version="1.0" encoding="utf-8"?>
<!-- 界面布局:可直接手改;颜色与尺寸引用 res/values 令牌(DesignRuleTest 校验触摸目标与令牌化) -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
    <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SecureDroid.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/sd_space_4"
                    android:paddingTop="14dp"
                    android:paddingEnd="@dimen/sd_space_4"
                    android:paddingBottom="@dimen/sd_space_3"
                    android:text="@string/sd_section_audit"
                    android:textAppearance="@style/TextAppearance.SecureDroid.CardHead"
                    android:textColor="@color/c_section" />
            <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sd_hairline_width"
                    android:background="@color/c_border" />
            <TextView
                    android:id="@+id/tvSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/sd_row_height"
                    android:paddingStart="@dimen/sd_space_4"
                    android:paddingTop="14dp"
                    android:paddingEnd="@dimen/sd_space_4"
                    android:paddingBottom="14dp"
                    android:textAppearance="@style/TextAppearance.SecureDroid.RowTitle"
                    android:textColor="@color/c_foreground" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SecureDroid.Card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/sd_space_4"
            android:layout_weight="1">
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
            <TextView
                    android:id="@+id/tvEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingStart="@dimen/sd_space_4"
                    android:paddingTop="32dp"
                    android:paddingEnd="@dimen/sd_space_4"
                    android:paddingBottom="32dp"
                    android:text="@string/audit_empty"
                    android:textAppearance="@style/TextAppearance.SecureDroid.EmptyHint"
                    android:textColor="@color/c_muted_foreground"
                    android:visibility="gone" />
            <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAudit"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:layoutAnimation="@anim/sd_list_layout" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
