<?xml version="1.0" encoding="utf-8"?>
<!-- iOS inset grouped 的行:行本身不带卡片,分组卡片由外层容器提供 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/sd_row_height"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/sd_gutter"
    android:paddingVertical="@dimen/sd_space_3">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.SecureDroid.Body"
        android:textColor="@color/sd_text" />

    <TextView
        android:id="@+id/tvSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.SecureDroid.Label"
        android:textColor="@color/sd_text_secondary" />
</LinearLayout>