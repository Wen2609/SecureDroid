<?xml version="1.0" encoding="utf-8"?>
<!-- 由 design/generate_layouts.mjs 从设计令牌生成;请勿手改,改令牌或改脚本后重跑 -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/sd_row_height"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/sd_space_4"
        android:paddingVertical="@dimen/sd_space_3">
    <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.SecureDroid.Body"
            android:textColor="@color/c_foreground" />
    <TextView
            android:id="@+id/tvSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.SecureDroid.Label"
            android:textColor="@color/c_muted_foreground" />
    </LinearLayout>
