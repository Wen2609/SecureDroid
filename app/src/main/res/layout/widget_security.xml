<?xml version="1.0" encoding="utf-8"?>
<!-- 由 design/generate_layouts.mjs 从设计令牌生成;请勿手改,改令牌或改脚本后重跑 -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/c_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/sd_space_4">
    <ImageView
            android:id="@+id/widgetIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_shield"
            app:tint="@color/c_accent" />
    <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/sd_space_3"
            android:layout_weight="1"
            android:orientation="vertical">
        <TextView
                android:id="@+id/widgetTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/c_foreground"
                android:textSize="16sp"
                android:textStyle="bold" />
        <TextView
                android:id="@+id/widgetScan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/sd_touch_min"
                android:text="@string/btn_go_scan"
                android:textColor="@color/c_accent"
                android:textSize="14sp" />
        </LinearLayout>
    <TextView
            android:id="@+id/widgetOpen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/sd_touch_min"
            android:text="@string/app_name"
            android:textColor="@color/c_muted_foreground"
            android:textSize="14sp" />
    </LinearLayout>
